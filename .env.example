# Persatrix Environment Variables
# Copy to .env and fill in your values.

# ─── Required (unless running offline — see below) ──
ANTHROPIC_API_KEY=sk-ant-...

# ─── Offline / demo mode: $0, no API key, no network ─
# Set to 1 to route EVERY agent to the built-in MockProvider — scripted
# persona replies, no LLM calls, no cost. Perfect for trying the society,
# demos, and CI smoke runs. The easiest path is `make demo-offline`; this
# var is the underlying knob if you wire your own run.
# PERSATRIX_OFFLINE=1
# Override the curated-replies file (defaults to config/offline_responses.yaml):
# PERSATRIX_OFFLINE_RESPONSES=config/offline_responses.yaml

# ─── Optional: OpenAI / local models (Ollama, vLLM) ──
# OPENAI_API_KEY=sk-...

# ─── Optional: MCP Servers ──────────────────────────
# GITHUB_TOKEN=ghp_...

# ─── Optional: External Bridges (v0.2+) ─────────────
# EMAIL_USERNAME=
# EMAIL_PASSWORD=
# SLACK_BOT_TOKEN=xoxb-...
# DISCORD_BOT_TOKEN=
# TELEGRAM_BOT_TOKEN=

# ─── Optional: Observability ────────────────────────
# AGENTOPS_API_KEY=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGSMITH_API_KEY=

# ─── Optional: Node Auth (v0.3+) ────────────────────
# NODE_AUTH_TOKEN=
