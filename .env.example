# Persatrix Environment Variables
# Copy to .env and fill in your values.

# ─── Pick a provider ────────────────────────────────
# Persatrix is provider-agnostic (RFC 0033 — "Any Model, Any Provider") with
# NO default provider: the society runs on whatever provider the `quality` /
# `fast` / `summarizer` model aliases in config/optimization.yaml point at, and
# they ship UNCONFIGURED — you pick one explicitly (a `make demo-*`, or by
# editing those aliases). Set the API key for the provider you choose; the
# others can stay blank. (No key at all? Use offline or local mode below — both
# are $0 and need no key.)
#
# Anthropic:
# ANTHROPIC_API_KEY=sk-ant-...
# OpenAI (and other OpenAI-compatible APIs — vLLM, Together, Groq, LM Studio):
# OPENAI_API_KEY=sk-...

# ─── Zero-config demos ──────────────────────────────
# Each demo selects its provider by mounting an alias config (config/demo/) —
# there is no force-knob env var, and no default provider. One command each:
#   make demo-offline   # mock provider: scripted replies, $0, no key, no network
#   make demo-ollama    # a REAL model served locally by Ollama: no key, no cloud spend
#   make demo-anthropic # the Anthropic (Claude) cloud peer (needs ANTHROPIC_API_KEY above)
#   make demo-openai    # the OpenAI cloud peer (needs OPENAI_API_KEY above)

# ─── Offline mode tuning (optional) ─────────────────
# Override the curated-replies file the mock reads (default
# config/offline_responses.yaml). Mock *configuration*, not provider selection.
# PERSATRIX_OFFLINE_RESPONSES=config/offline_responses.yaml

# ─── Local models via Ollama (optional tuning) ──────
# `make demo-ollama` bundles + pulls the model for you. These knobs apply when
# you point an alias at `provider: ollama` yourself, or want to change the demo
# model. They configure the ollama provider — they do not select it.
# Model to pull/use (must be an Ollama tag; default llama3.2):
# PERSATRIX_OLLAMA_MODEL=llama3.2
# Daemon endpoint (OpenAI-compatible /v1 path; default http://localhost:11434/v1):
# PERSATRIX_OLLAMA_BASE_URL=http://localhost:11434/v1

# ─── Optional: MCP Servers ──────────────────────────
# GITHUB_TOKEN=ghp_...

# ─── Optional: External Bridges (v0.2+) ─────────────
# EMAIL_USERNAME=
# EMAIL_PASSWORD=
# SLACK_BOT_TOKEN=xoxb-...
# DISCORD_BOT_TOKEN=
# TELEGRAM_BOT_TOKEN=

# ─── Optional: Observability ────────────────────────
# AGENTOPS_API_KEY=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGSMITH_API_KEY=

# ─── Optional: Node Auth (v0.3+) ────────────────────
# NODE_AUTH_TOKEN=
