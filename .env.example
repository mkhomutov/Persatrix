# Persatrix Environment Variables
# Copy to .env and fill in your values.

# ─── Required ────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Optional: OpenAI (for fallback/comparison) ─────
# OPENAI_API_KEY=sk-...

# ─── Optional: MCP Servers ──────────────────────────
# GITHUB_TOKEN=ghp_...

# ─── Optional: External Bridges (v0.2+) ─────────────
# EMAIL_USERNAME=
# EMAIL_PASSWORD=
# SLACK_BOT_TOKEN=xoxb-...
# DISCORD_BOT_TOKEN=
# TELEGRAM_BOT_TOKEN=

# ─── Optional: Observability ────────────────────────
# AGENTOPS_API_KEY=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGSMITH_API_KEY=

# ─── Optional: Node Auth (v0.3+) ────────────────────
# NODE_AUTH_TOKEN=
