# Persatrix Environment Variables
# Copy to .env and fill in your values.

# ─── Required (unless running offline — see below) ──
ANTHROPIC_API_KEY=sk-ant-...

# ─── Offline / demo mode: $0, no API key, no network ─
# Set to 1 to route EVERY agent to the built-in MockProvider — scripted
# persona replies, no LLM calls, no cost. Perfect for trying the society,
# demos, and CI smoke runs. The easiest path is `make demo-offline`; this
# var is the underlying knob if you wire your own run.
# PERSATRIX_OFFLINE=1
# Override the curated-replies file (defaults to config/offline_responses.yaml):
# PERSATRIX_OFFLINE_RESPONSES=config/offline_responses.yaml

# ─── Local models via Ollama: real model, no API key, no cloud spend ─
# Set to 1 to route EVERY agent to a model served locally by Ollama — real
# inference on your own machine, no API key, no per-token cost. Easiest path is
# `make demo-ollama` (bundles + pulls the model); these vars are the knobs if
# you wire your own run or use a per-agent `provider: ollama` in agents.yaml.
# PERSATRIX_OLLAMA=1
# Model to pull/use (must be an Ollama tag; default llama3.2):
# PERSATRIX_OLLAMA_MODEL=llama3.2
# Daemon endpoint (OpenAI-compatible /v1 path; default http://localhost:11434/v1):
# PERSATRIX_OLLAMA_BASE_URL=http://localhost:11434/v1

# ─── Optional: OpenAI / other OpenAI-compatible APIs (vLLM, Together) ──
# OPENAI_API_KEY=sk-...

# ─── Optional: MCP Servers ──────────────────────────
# GITHUB_TOKEN=ghp_...

# ─── Optional: External Bridges (v0.2+) ─────────────
# EMAIL_USERNAME=
# EMAIL_PASSWORD=
# SLACK_BOT_TOKEN=xoxb-...
# DISCORD_BOT_TOKEN=
# TELEGRAM_BOT_TOKEN=

# ─── Optional: Observability ────────────────────────
# AGENTOPS_API_KEY=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGSMITH_API_KEY=

# ─── Optional: Node Auth (v0.3+) ────────────────────
# NODE_AUTH_TOKEN=
