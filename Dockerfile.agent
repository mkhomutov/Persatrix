# Persatrix Agent Runtime (Python)
FROM python:3.12-slim

WORKDIR /app
COPY agents/ agents/
# Fallback config for standalone builds (without docker-compose).
# In compose, ./config is bind-mounted at /app/config:ro and shadows this copy.
COPY config/ config/
# Pin the optimization-config path for the installed package: pip installs the
# agents tree as `persatrix_agents`, so `agents/optimization.py`'s
# package-relative default resolves into site-packages where no config exists
# (only prompts/ is copied there, below). Without this pin every accessor
# silently returned its default — most visibly summarization_model() == "" →
# the close-path summary degraded to the "[interaction summary unavailable]"
# sentinel with a per-close WARN under every provider overlay. Pinned here at
# the deployment layer (the v0.3.8 fix) rather than via a CWD-relative
# fallback in library code, so resolution never depends on the process
# working directory. Operators can still override per-deployment.
ENV PERSATRIX_OPTIMIZATION_CONFIG=/app/config/optimization.yaml
# Non-editable install: -e is a dev pattern that complicates layer caching
# and adds no value in containers where source is already copied.
# Layer ordering: pip install is intentionally placed before COPY prompts/ so
# that editing prompt files does not bust the pip cache and force a full
# package re-download on every CI rebuild.
#
# RFC 0053 — optional provider SDKs ship as pyproject extras (OQ #4) so a
# single-provider deployment stays lean. AGENT_EXTRAS lets a provider demo
# overlay install its extra at build time (e.g. docker-compose.gemini.yaml sets
# `AGENT_EXTRAS: gemini` → `pip install "./agents[gemini]"`, pulling in
# google-genai). Default empty → `pip install "./agents"`, byte-for-byte the
# same closure every non-extra image ships today.
ARG AGENT_EXTRAS=""
RUN pip install --no-cache-dir "./agents${AGENT_EXTRAS:+[$AGENT_EXTRAS]}"

# RFC 0009 PR 1b: copy prompts into site-packages where the installed package
# looks for them. The package resolves prompts relative to
# Path(__file__).parent.parent, which resolves to site-packages/ in
# non-editable container installs (not the repo root). Placed after pip install
# to keep the pip layer cache hot across prompt-only edits.
COPY prompts/ prompts/
RUN SITE_PKGS=$(python -c 'import sysconfig; print(sysconfig.get_path("purelib"))') && \
    cp -r prompts "$SITE_PKGS/"

# Security: run as non-root to limit blast radius if agent code is compromised
# (agents execute LLM-suggested actions and must be sandboxed).
RUN useradd -r -s /bin/false appuser \
    && mkdir -p /workspace /app/data \
    && chown appuser:appuser /workspace /app/data
USER appuser

ENTRYPOINT ["python", "-m", "persatrix_agents.server"]
