# Prevent sending unnecessary files to Docker daemon during builds.
# Without this, the entire repo context (build artifacts, .git, docs, etc.)
# is sent to the daemon, significantly slowing builds.

# Version control
.git/
.gitignore

# Build artifacts
bin/
cli/target/

# Dependencies / caches
# NOTE: `**/` is required to also match *nested* dirs (e.g. web/node_modules).
# A bare `node_modules/` is anchored to the context root and would let the
# host's web/node_modules leak through `COPY web/ ./` in Dockerfile.orchestrator,
# clobbering the clean in-image `npm ci` with a host-platform tree (ISSUE-0104).
vendor/
**/node_modules/
__pycache__/
*.pyc
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/

# IDE
.vscode/
.idea/

# Environment / secrets
.env
.env.*

# Documentation (not needed in images)
docs/
*.md
LICENSE

# Tests (not needed in production images)
tests/
evaluators/

# OS files
.DS_Store
Thumbs.db
