# Orchestr8 Orchestrator (Go)
FROM golang:1.24-alpine AS builder

WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ cmd/
COPY internal/ internal/
RUN CGO_ENABLED=0 go build -o orchestr8-server ./cmd/orchestrator

FROM alpine:3.20
RUN apk --no-cache add ca-certificates wget
COPY --from=builder /build/orchestr8-server /usr/local/bin/

# Security: run as non-root to follow container best practices.
RUN adduser -D -H appuser
USER appuser

EXPOSE 9090 8080
ENTRYPOINT ["orchestr8-server"]
CMD ["--config", "/app/config/"]
