{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://persatrix.dev/schemas/channel.schema.json",
  "title": "Persatrix Channel Configuration (v0.2+)",
  "type": "object",
  "required": ["schema_version"],
  "properties": {
    "schema_version": { "type": "string" },
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string", "enum": ["group", "direct", "broadcast", "meeting"] },
          "name": { "type": "string" },
          "members": {
            "oneOf": [
              { "type": "string", "const": "all" },
              { "type": "array", "items": { "type": "string" } }
            ]
          },
          "history_visible": { "type": "boolean" },
          "max_history_messages": { "type": "integer" }
        }
      }
    }
  }
}
