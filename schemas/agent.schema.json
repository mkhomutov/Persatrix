{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://orchestr8.dev/schemas/agent.schema.json",
  "title": "Orchestr8 Agent Configuration",
  "type": "object",
  "required": ["schema_version", "agents"],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["0.1", "0.2"]
    },
    "agents": {
      "type": "array",
      "items": { "$ref": "#/definitions/agent" }
    }
  },
  "definitions": {
    "agent": {
      "type": "object",
      "required": ["id", "name", "role", "model"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$",
          "description": "Unique agent identifier (lowercase, hyphens allowed)"
        },
        "type": {
          "type": "string",
          "enum": ["task", "persona"],
          "default": "task",
          "description": "Agent type: task (responds to assigned work) or persona (event-driven with autonomy)"
        },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "model": { "type": "string" },
        "instructions": {
          "type": "string",
          "description": "System prompt instructions for task agents (required when type=task)"
        },
        "temperature": {
          "type": "number", "minimum": 0, "maximum": 2, "default": 0.3
        },
        "capabilities": {
          "type": "array", "items": { "type": "string" }
        },
        "tools": {
          "type": "array", "items": { "type": "string" }
        },
        "max_retries": {
          "type": "integer", "minimum": 0, "default": 2
        },
        "timeout_seconds": {
          "type": "integer", "minimum": 1, "default": 120
        },
        "permissions": { "$ref": "#/definitions/permissions" },
        "persona": { "$ref": "#/definitions/persona" },
        "autonomy": { "$ref": "#/definitions/autonomy" },
        "memory": { "$ref": "#/definitions/memory" },
        "relationships": {
          "type": "array",
          "items": { "$ref": "#/definitions/relationship" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "persona" } },
            "required": ["type"]
          },
          "then": {
            "required": ["persona"],
            "properties": {
              "persona": { "$ref": "#/definitions/persona" }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "task" } },
            "required": ["type"]
          },
          "then": {
            "required": ["instructions"]
          }
        }
      ]
    },
    "permissions": {
      "type": "object",
      "properties": {
        "filesystem": {
          "type": "object",
          "properties": {
            "read": { "type": "array", "items": { "type": "string" } },
            "write": { "type": "array", "items": { "type": "string" } },
            "deny": { "type": "array", "items": { "type": "string" } }
          }
        },
        "network": {
          "type": "object",
          "properties": {
            "allow": { "type": "array", "items": { "type": "string" } },
            "deny": { "type": "array", "items": { "type": "string" } }
          }
        },
        "shell": {
          "type": "object",
          "properties": {
            "allowed_commands": { "type": "array", "items": { "type": "string" } },
            "max_execution_seconds": { "type": "integer" }
          }
        }
      }
    },
    "persona": {
      "type": "object",
      "required": ["title", "background", "behavior"],
      "properties": {
        "title": { "type": "string" },
        "background": { "type": "string" },
        "behavior": {
          "type": "object",
          "description": "Structured behavioral dimensions (RFC 0005). Replaces free-text personality.traits / communication_style / decision_making. Individual dimensions are optional — omitted dimensions default to their middle value.",
          "properties": {
            "directness": {
              "type": "string",
              "enum": ["indirect", "balanced", "direct"],
              "default": "balanced"
            },
            "detail_focus": {
              "type": "string",
              "enum": ["big-picture", "balanced", "detail-focused"],
              "default": "balanced"
            },
            "formality": {
              "type": "string",
              "enum": ["casual", "professional", "formal"],
              "default": "professional"
            },
            "risk_tolerance": {
              "type": "string",
              "enum": ["cautious", "moderate", "bold"],
              "default": "moderate"
            },
            "expressiveness": {
              "type": "string",
              "enum": ["reserved", "moderate", "expressive"],
              "default": "moderate"
            }
          },
          "additionalProperties": false
        },
        "quirks": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Free-text character voice and flavor"
        },
        "goals": {
          "type": "object",
          "properties": {
            "primary": { "type": "string" },
            "secondary": { "type": "array", "items": { "type": "string" } },
            "hidden": { "type": "string" }
          }
        },
        "knowledge": {
          "type": "object",
          "properties": {
            "domains": { "type": "array", "items": { "type": "string" } },
            "limitations": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "autonomy": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": ["passive", "reactive", "semi-autonomous", "autonomous", "supervisor"]
        },
        "tick_interval_seconds": {
          "type": "integer",
          "minimum": 1,
          "default": 60,
          "description": "Seconds between autonomous tick cycles"
        },
        "max_actions_per_tick": {
          "type": "integer",
          "minimum": 1,
          "default": 3,
          "description": "Maximum actions executed per tick cycle"
        },
        "idle_after_ticks": {
          "type": "integer",
          "minimum": 1,
          "default": 10,
          "description": "Reduce activity after this many consecutive idle ticks"
        },
        "can_initiate_conversations": { "type": "boolean" },
        "can_delegate_tasks": { "type": "boolean" },
        "can_spawn_sub_agents": { "type": "boolean" },
        "requires_approval_for": {
          "type": "array", "items": { "type": "string" }
        }
      }
    },
    "memory": {
      "type": "object",
      "description": "Memory configuration for persona agents (RFC 0005)",
      "properties": {
        "db_path": {
          "type": "string",
          "default": "data/memory.db",
          "description": "Path to the shared SQLite memory database"
        },
        "notes": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true,
              "description": "Whether the agent can use memory tools (store_note, etc.)"
            },
            "max_notes": {
              "type": "integer",
              "minimum": 1,
              "default": 500,
              "description": "Per-agent note cap; oldest low-access notes pruned when exceeded"
            },
            "auto_reflect_after": {
              "type": "integer",
              "minimum": 1,
              "default": 5,
              "description": "Inject reflection nudge after N interactions"
            },
            "inject_recent_notes": {
              "type": "integer",
              "minimum": 0,
              "default": 3,
              "description": "Number of most relevant notes to include in context per LLM call"
            }
          }
        }
      }
    },
    "relationship": {
      "type": "object",
      "required": ["agent_id", "type"],
      "properties": {
        "agent_id": { "type": "string" },
        "type": { "type": "string" },
        "trust_level": { "type": "number", "minimum": 0, "maximum": 1 },
        "notes": { "type": "string" }
      }
    }
  }
}
