{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://persatrix.dev/schemas/agent.schema.json",
  "title": "Persatrix Agent Configuration",
  "type": "object",
  "required": ["schema_version", "agents"],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["0.1", "0.2"]
    },
    "agents": {
      "type": "array",
      "items": { "$ref": "#/definitions/agent" }
    }
  },
  "definitions": {
    "agent": {
      "type": "object",
      "required": ["id", "name", "role", "model"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$",
          "description": "Unique agent identifier (lowercase, hyphens allowed)"
        },
        "type": {
          "type": "string",
          "enum": ["task", "persona"],
          "default": "task",
          "description": "Agent type: task (responds to assigned work) or persona (event-driven with autonomy)"
        },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "model": { "type": "string" },
        "instructions": {
          "type": "string",
          "description": "Inline system prompt instructions for task agents. Mutually exclusive with 'instructions_file'. Either field is required when type=task."
        },
        "instructions_file": {
          "type": "string",
          "pattern": "^prompts/",
          "description": "Repo-root-relative path to a markdown file containing system prompt instructions. Must live under prompts/. Mutually exclusive with 'instructions'. The pattern enforces the prompts/ subtree at validate time as defense-in-depth; the runtime loader (agents.prompt_loader) is the authoritative deny-by-default control."
        },
        "temperature": {
          "type": "number", "minimum": 0, "maximum": 2, "default": 0.3
        },
        "capabilities": {
          "type": "array", "items": { "type": "string" }
        },
        "tools": {
          "type": "array", "items": { "type": "string" }
        },
        "max_retries": {
          "type": "integer", "minimum": 0, "default": 2
        },
        "timeout_seconds": {
          "type": "integer", "minimum": 1, "default": 120
        },
        "max_llm_calls": {
          "type": "integer", "minimum": 1,
          "description": "Maximum number of LLM calls per task (agent-level default for cascade)"
        },
        "max_tokens": {
          "type": "integer", "minimum": 1,
          "description": "Maximum output tokens per LLM call (agent-level default for cascade)"
        },
        "permissions": { "$ref": "#/definitions/permissions" },
        "persona": { "$ref": "#/definitions/persona" },
        "autonomy": { "$ref": "#/definitions/autonomy" },
        "memory": { "$ref": "#/definitions/memory" },
        "relationships": {
          "type": "array",
          "items": { "$ref": "#/definitions/relationship" }
        }
      },
      "allOf": [
        {
          "$comment": "Conditional validation: each if-block requires 'type' to be present (required: [type]) so that v0.1 agents — which omit the 'type' field entirely — skip these conditionals and pass validation without 'persona' or 'instructions'. This is intentional backward-compatibility: v0.1 and v0.2 agent entries coexist in the same agents.yaml.",
          "if": {
            "properties": { "type": { "const": "persona" } },
            "required": ["type"]
          },
          "then": {
            "required": ["persona"],
            "properties": {
              "persona": { "$ref": "#/definitions/persona" }
            },
            "$comment": "Persona agents must not declare task-agent prompt fields. Both 'instructions' and 'instructions_file' are silently ignored by create_persona_agent, which makes them an operator footgun; rejecting at validate time surfaces the misconfiguration before runtime.",
            "not": {
              "anyOf": [
                { "required": ["instructions"] },
                { "required": ["instructions_file"] }
              ]
            }
          }
        },
        {
          "$comment": "Task agents must declare exactly one of 'instructions' or 'instructions_file'. 'oneOf' (rather than 'anyOf') catches the both-fields-set conflict at validate time; the runtime loader still enforces the same rule as defense-in-depth.",
          "if": {
            "properties": { "type": { "const": "task" } },
            "required": ["type"]
          },
          "then": {
            "oneOf": [
              { "required": ["instructions"] },
              { "required": ["instructions_file"] }
            ]
          }
        },
        {
          "$comment": "Safety net: if an agent configures persona-specific fields but omits 'type', require 'type' to prevent silent misconfiguration. Without this, a v0.2 persona agent missing 'type' would skip both conditionals above and validate without 'instructions' or 'persona' being required.",
          "if": {
            "anyOf": [
              { "required": ["persona"] },
              { "required": ["autonomy"] },
              { "required": ["memory"] }
            ]
          },
          "then": {
            "required": ["type"]
          }
        }
      ]
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "filesystem": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "read": { "type": "array", "items": { "type": "string" } },
            "write": { "type": "array", "items": { "type": "string" } },
            "deny": { "type": "array", "items": { "type": "string" } }
          }
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allow": { "type": "array", "items": { "type": "string" } },
            "deny": { "type": "array", "items": { "type": "string" } }
          }
        },
        "shell": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowed_commands": { "type": "array", "items": { "type": "string" } },
            "max_execution_seconds": { "type": "integer" }
          }
        },
        "memory": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "read": { "type": "boolean", "description": "Allow reading notes from memory" },
            "write": { "type": "boolean", "description": "Allow writing/updating/deleting notes in memory" }
          }
        }
      }
    },
    "persona": {
      "type": "object",
      "required": ["title", "background", "behavior"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "background": { "type": "string" },
        "behavior": {
          "type": "object",
          "description": "Structured behavioral dimensions (RFC 0005). Replaces free-text personality.traits / communication_style / decision_making. Individual dimensions are optional — omitted dimensions default to their middle value.",
          "properties": {
            "directness": {
              "type": "string",
              "enum": ["indirect", "balanced", "direct"],
              "default": "balanced"
            },
            "detail_focus": {
              "type": "string",
              "enum": ["big-picture", "balanced", "detail-focused"],
              "default": "balanced"
            },
            "formality": {
              "type": "string",
              "enum": ["casual", "professional", "formal"],
              "default": "professional"
            },
            "risk_tolerance": {
              "type": "string",
              "enum": ["cautious", "moderate", "bold"],
              "default": "moderate"
            },
            "expressiveness": {
              "type": "string",
              "enum": ["reserved", "moderate", "expressive"],
              "default": "moderate"
            }
          },
          "additionalProperties": false
        },
        "quirks": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Free-text character voice and flavor"
        },
        "goals": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "primary": { "type": "string" },
            "secondary": { "type": "array", "items": { "type": "string" } },
            "hidden": { "type": "string" }
          }
        },
        "knowledge": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "domains": { "type": "array", "items": { "type": "string" } },
            "limitations": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "autonomy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {
          "type": "string",
          "enum": ["passive", "reactive", "semi-autonomous", "autonomous", "supervisor"]
        },
        "tick_interval_seconds": {
          "type": "integer",
          "minimum": 1,
          "default": 60,
          "description": "Seconds between autonomous tick cycles"
        },
        "max_actions_per_tick": {
          "type": "integer",
          "minimum": 1,
          "default": 3,
          "description": "Maximum actions executed per tick cycle"
        },
        "idle_after_ticks": {
          "type": "integer",
          "minimum": 1,
          "default": 10,
          "description": "Reduce activity after this many consecutive idle ticks"
        },
        "can_initiate_conversations": { "type": "boolean" },
        "can_delegate_tasks": { "type": "boolean" },
        "can_spawn_sub_agents": { "type": "boolean" },
        "requires_approval_for": {
          "type": "array", "items": { "type": "string" }
        }
      }
    },
    "memory": {
      "type": "object",
      "description": "Memory configuration for persona agents (RFC 0005)",
      "additionalProperties": false,
      "properties": {
        "db_path": {
          "type": "string",
          "minLength": 1,
          "default": "data/memory.db",
          "description": "Path to the shared SQLite memory database"
        },
        "interaction_idle_timeout_sec": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 600,
          "description": "Idle window (seconds) after which an open multi-turn interaction is closed by IdleGapDetector (RFC 0020 §B). Threaded into InteractionTracker at runtime startup."
        },
        "notes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true,
              "description": "Whether the agent can use memory tools (store_note, etc.)"
            },
            "max_notes": {
              "type": "integer",
              "minimum": 1,
              "default": 500,
              "description": "Per-agent note cap; oldest low-access notes pruned when exceeded"
            },
            "auto_reflect_after": {
              "type": "integer",
              "minimum": 1,
              "default": 5,
              "description": "Inject reflection nudge after N interactions"
            },
            "inject_recent_notes": {
              "type": "integer",
              "minimum": 0,
              "default": 3,
              "description": "Number of most relevant notes to include in context per LLM call"
            }
          }
        },
        "episodic": {
          "type": "object",
          "description": "Episodic memory configuration (extension spec E7.2)",
          "additionalProperties": false,
          "properties": {
            "retention_days": {
              "type": "integer",
              "minimum": 1,
              "default": 90,
              "description": "Hard-delete compressed episodes older than this many days (per E7.2)"
            }
          }
        },
        "relationship": {
          "type": "object",
          "description": "Relationship memory configuration (extension spec E7.2)",
          "additionalProperties": false,
          "properties": {
            "decay_rate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0.01,
              "description": "Per-cycle trust decay rate toward neutral (0.5). Higher values cause faster trust erosion without reinforcement."
            }
          }
        }
      }
    },
    "relationship": {
      "type": "object",
      "required": ["agent_id", "type"],
      "additionalProperties": false,
      "properties": {
        "agent_id": { "type": "string" },
        "type": { "type": "string" },
        "trust_level": { "type": "number", "minimum": 0, "maximum": 1 },
        "notes": { "type": "string" }
      }
    }
  }
}
