# Enforce package.json "engines" (node ^22.22.2 || ^24.15.0 || >=26.0.0) on
# install. Without this, the engines field is advisory — npm warns but proceeds,
# so a contributor on an older Node could build a subtly broken bundle. With it,
# `npm ci`/`npm install` (and the `make ui` / CI lanes that call them) fail fast
# on an unsupported Node. The range is the strictest one any locked package
# declares (jsdom 30 today); tests/unit/python/test_web_node_engines_floor.py
# fails when a dependency bump raises it past what package.json says.
engine-strict=true
