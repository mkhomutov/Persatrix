# Enforce package.json "engines" (node ^22.22.2 || ^24.15.0 || >=26.0.0) on
# install. Without this, the engines field is advisory — npm warns but proceeds,
# so a contributor on an older Node could build a subtly broken bundle. With it,
# `npm ci`/`npm install` (and the `make ui` / CI lanes that call them) fail fast
# on an unsupported Node. The range must be no looser than any locked package's
# own engines.node (jsdom 30's is the tightest today), and CI and the Docker
# ui-builder stage build on its lowest version.
# tests/unit/python/test_web_node_engines_floor.py fails when a dependency bump
# needs a newer Node than package.json says.
engine-strict=true
